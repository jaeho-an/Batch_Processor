<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"https://mybatis.org/dtd/mybatis-3-mapper.dtd">
	
<mapper namespace="repository.external.ExternalRepository">
	
	<select id="selectExternalUsers" resultType="domain.User">
		SELECT
			USER_ID, USER_NAME, PASSWORD, GROUP_ID,
			EMAIL, PHONE, EXPLOY_STATUS
		FROM
			EXTERNAL_USER
	</select>
	
	<select id="selectExternalGroups" resultType="domain.Group">
		SELECT
			GROUP_ID, GROUP_NAME, STATUS
		FROM
			EXTERNAL_GROUP
	</select>
	
</mapper>